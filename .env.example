# URL de la API del backend
VITE_API_URL=http://localhost:4000

# Google OAuth - Obtener en: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Conekta - Llave pública (segura para exponer en el frontend)
# Obtener en: https://panel.conekta.com/
VITE_CONEKTA_PUBLIC_KEY=key_your_conekta_public_key_here
