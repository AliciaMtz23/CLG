# Configuración del Servidor Node
PORT=4000

# URL del frontend (para CORS en producción)
FRONTEND_URL=http://localhost:5173

# Configuración de la Base de Datos (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=koahwh_db
DB_PORT=3306

# JWT - Usar una cadena larga y aleatoria en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# Google OAuth - Obtener en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here

# Conekta - Llave privada (NUNCA exponer en el frontend)
# Obtener en: https://panel.conekta.com/
CONEKTA_PRIVATE_KEY=key_your_conekta_private_key_here

# Email (Nodemailer) - Usar contraseña de aplicación de Gmail
# Generar en: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
